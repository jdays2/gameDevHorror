  m_Script: {fileID: 11500000, guid: cf8fe0a398451c64d83082d14cf804c4, type: 3}
  m_Name: SandboxConversation
  m_EditorClassIdentifier: EmergencyShift.Runtime::EmergencyShift.DialogueSequence
  entryId: warning
  speakers:
  - displayName: "\u0414\u0435\u0436\u0443\u0440\u043D\u044B\u0439 \u0432\u0440\u0430\u0447"
    portrait: {fileID: 0}
  - displayName: "\u0412\u044B"
    portrait: {fileID: 0}
  lines:
  - id: warning
    speaker: 0
    text: "\u041D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0439\u0442\u0435 \u0434\u0432\u0435\u0440\u044C. \u0427\u0442\u043E \u0431\u044B \u0432\u044B \u043D\u0438 \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u0441 \u0442\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u2014 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0439\u0442\u0435."
    nextId: question
    choices: []
  - id: question
    speaker: 0
    text: "\u0412\u044B \u0432\u0435\u0434\u044C \u0442\u043E\u0436\u0435 \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u044D\u0442\u043E\u0442 \u0433\u043E\u043B\u043E\u0441? \u0427\u0442\u043E \u0431\u0443\u0434\u0435\u043C \u0434\u0435\u043B\u0430\u0442\u044C?"
    nextId: 
    choices:
    - id: help
      text: "\u0422\u0430\u043C \u043F\u0440\u043E\u0441\u044F\u0442 \u043E \u043F\u043E\u043C\u043E\u0449\u0438. \u042F \u0445\u043E\u0447\u0443 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C."
      targetId: help-reply
    - id: leave
      text: "\u041D\u0435 \u0431\u0443\u0434\u0435\u043C \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C. \u041D\u0430\u0439\u0434\u0451\u043C \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u0443\u0442\u044C."
      targetId: leave-reply
  - id: help-reply
    speaker: 1
    text: "\u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0439\u0442\u0438, \u0435\u0441\u043B\u0438 \u0442\u0430\u043C \u0435\u0449\u0451 \u043A\u0442\u043E-\u0442\u043E \u0436\u0438\u0432\u043E\u0439."
    nextId: help-warning
    choices: []
  - id: help-warning
    speaker: 0
    text: "\u042F \u0442\u043E\u0436\u0435 \u0442\u0430\u043A \u0434\u0443\u043C\u0430\u043B. \u041F\u043E\u043A\u0430 \u043E\u043D\u043E \u043D\u0435 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u043E \u043C\u043E\u0438\u043C \u0433\u043E\u043B\u043E\u0441\u043E\u043C. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0437\u0430\u0433\u043B\u044F\u043D\u0435\u043C \u0447\u0435\u0440\u0435\u0437 \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u043E\u0435 \u043E\u043A\u043D\u043E."
    nextId: rejoin
    choices: []
  - id: leave-reply
    speaker: 1
    text: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0414\u0432\u0435\u0440\u044C \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0439. \u0413\u0434\u0435 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0439 \u0432\u044B\u0445\u043E\u0434?"
    nextId: leave-direction
    choices: []
  - id: leave-direction
    speaker: 0
    text: "\u0417\u0430 \u043F\u043E\u0441\u0442\u043E\u043C \u0435\u0441\u0442\u044C \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u044B\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440. \u0415\u0441\u043B\u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435, \u043C\u044B \u0434\u043E\u0431\u0435\u0440\u0451\u043C\u0441\u044F \u0434\u043E \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u044B."
    nextId: rejoin
    choices: []
  - id: rejoin
    speaker: 1
    text: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0439\u0434\u0451\u043C \u0447\u0435\u0440\u0435\u0437 \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u044B\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440. \u042F \u043E\u0441\u0442\u0430\u043D\u0443\u0441\u044C \u0440\u044F\u0434\u043E\u043C."
    nextId: 
    choices: []
