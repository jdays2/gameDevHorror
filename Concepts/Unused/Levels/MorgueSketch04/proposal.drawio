mxGeometry x="158.8" y="441.4" width="78" height="30" as="geometry" /></mxCell><mxCell id="65" parent="1" vertex="1" value="Морг" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#252c32;fontStyle=0;"><mxGeometry x="158.8" y="481.0" width="50" height="31" as="geometry" /></mxCell><mxCell id="66" parent="1" vertex="1" value="Патроны" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#252c32;fontStyle=0;"><mxGeometry x="441.40000000000003" y="211.0" width="76" height="29" as="geometry" /></mxCell><mxCell id="67" parent="1" vertex="1" value="Пистолет" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#252c32;fontStyle=0;"><mxGeometry x="499.0" y="299.2" width="79" height="25" as="geometry" /></mxCell><mxCell id="68" parent="1" vertex="1" value="Распределительный зал" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#252c32;fontStyle=1;"><mxGeometry x="520.6" y="430.6" width="254" height="33" as="geometry" /></mxCell><mxCell id="69" parent="1" vertex="1" value="B3" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#4657c7;fontStyle=1;"><mxGeometry x="655.6" y="326.2" width="33" height="28" as="geometry" /></mxCell><mxCell id="70" parent="1" vertex="1" value="B1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#4657c7;fontStyle=1;"><mxGeometry x="531.4000000000001" y="630.4" width="33" height="28" as="geometry" /></mxCell><mxCell id="71" parent="1" vertex="1" value="B2" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#4657c7;fontStyle=1;"><mxGeometry x="648.4" y="639.4" width="33" height="28" as="geometry" /></mxCell><mxCell id="72" parent="1" vertex="1" value="Обход" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#252c32;fontStyle=0;"><mxGeometry x="954.4" y="459.4" width="59" height="29" as="geometry" /></mxCell><mxCell id="73" parent="1" vertex="1" value="ЗЕЛЁНАЯ" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#238856;fontStyle=1;"><mxGeometry x="875.2" y="709.6" width="89" height="26" as="geometry" /></mxCell><mxCell id="74" parent="1" vertex="1" value="КАРТА  G" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#238856;fontStyle=1;"><mxGeometry x="875.2" y="742.0" width="86" height="26" as="geometry" /></mxCell><mxCell id="75" parent="1" vertex="1" value="1  Вход к синей карте со стороны патронов — обычная дверь." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#bb6523;fontStyle=1;"><mxGeometry x="42" y="815" width="633" height="33" as="geometry" /></mxCell><mxCell id="76" parent="1" vertex="1" value="2  Убрать повторный зелёный замок у комнаты карты." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#bb6523;fontStyle=1;"><mxGeometry x="42" y="850" width="555" height="33" as="geometry" /></mxCell><mxCell id="77" parent="1" vertex="1" value="Серое — предлагаемые препятствия. B1–B3 — боковые ветки по синей карте." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#252c32;fontStyle=0;"><mxGeometry x="42" y="885" width="625" height="29" as="geometry" /></mxCell><mxCell id="78" parent="1" vertex="1" value="Геометрия слегка расширена для читаемости. Коллизии и бой ещё не проверены." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#252c32;fontStyle=0;"><mxGeometry x="42" y="917" width="661" height="29" as="geometry" /></mxCell><mxCell id="79" parent="1" vertex="1" value="Будущий путь к выходу по B — за пределами схемы; новые локации не добавлены." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#252c32;fontStyle=1;"><mxGeometry x="42" y="954" width="765" height="31" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>