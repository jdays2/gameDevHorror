        <mxCell value="P2: из U1 виден вид II через проём A." style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-632" parent="1">
          <mxGeometry x="1390" y="202" width="318.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="Здесь нужно показать реакцию на свет до" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-633" parent="1">
          <mxGeometry x="1390" y="227" width="357.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="выбора обоих путей; постановка ещё" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-634" parent="1">
