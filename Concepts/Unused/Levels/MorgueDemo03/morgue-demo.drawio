        </mxCell>
        <mxCell value="света. B — длиннее, через диагностику со" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-638" parent="1">
          <mxGeometry x="1390" y="384" width="350.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="Сталкером; больше знакомого контроля," style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-639" parent="1">
          <mxGeometry x="1390" y="409" width="348.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="но возможны погоня и расход." style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-640" parent="1">
          <mxGeometry x="1390" y="434" width="267.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="3 · Не только боевые двери" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=21;fontColor=#30373e;fontStyle=1;spacing=0;" vertex="1" id="element-641" parent="1">
          <mxGeometry x="1390" y="483" width="295.0" height="28.35" as="geometry" />
        </mxCell>
        <mxCell value="Вокруг пути — диагностика, служебная," style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-642" parent="1">
          <mxGeometry x="1390" y="516" width="333.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="персонал и хранилище. UO1 даёт модуль" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-643" parent="1">
          <mxGeometry x="1390" y="541" width="346.984375" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="за бой; S2 нужно найти. Ни одна награда" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-644" parent="1">
