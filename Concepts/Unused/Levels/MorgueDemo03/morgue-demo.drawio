        </mxCell>
        <mxCell value="4 · Арена устроена" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=21;fontColor=#30373e;fontStyle=1;spacing=0;" vertex="1" id="element-646" parent="1">
