        <mxCell value="Два смещённых острова: наружное" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-647" parent="1">
          <mxGeometry x="1390" y="673" width="302.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="кольцо, центральный проход и" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-648" parent="1">
          <mxGeometry x="1390" y="698" width="266.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="поперечные выходы. Вход игрока" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-649" parent="1">
          <mxGeometry x="1390" y="723" width="290.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="отделён от T1–T3 — направлений угроз." style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-650" parent="1">
          <mxGeometry x="1390" y="748" width="338.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="5 · До финального смешения" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=21;fontColor=#30373e;fontStyle=1;spacing=0;" vertex="1" id="element-651" parent="1">
          <mxGeometry x="1390" y="797" width="309.0" height="28.35" as="geometry" />
        </mxCell>
        <mxCell value="P3 / U4 резервируют знакомство с ролью" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-652" parent="1">
          <mxGeometry x="1390" y="830" width="356.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="III. Её свойства не выбраны. После" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-653" parent="1">
          <mxGeometry x="1390" y="855" width="292.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="победы — статистика, а не ещё одно" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-654" parent="1">
          <mxGeometry x="1390" y="880" width="310.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="отделение." style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-655" parent="1">
          <mxGeometry x="1390" y="905" width="96.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="Открыто" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=21;fontColor=#30373e;fontStyle=1;spacing=0;" vertex="1" id="element-656" parent="1">
          <mxGeometry x="1390" y="954" width="99.0" height="28.35" as="geometry" />
        </mxCell>
        <mxCell value="T1–T3 — предложения подачи, не три" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-657" parent="1">
          <mxGeometry x="1390" y="987" width="320.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="утверждённые волны. Тьма не даёт" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-658" parent="1">
          <mxGeometry x="1390" y="1012" width="298.984375" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="невидимость. Проверка вида II, босса," style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-659" parent="1">
          <mxGeometry x="1390" y="1037" width="325.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="ресурсов и повторов ещё впереди." style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-660" parent="1">
          <mxGeometry x="1390" y="1062" width="302.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="U1 → U3: A 18 / B 44 шагов сетки" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=17;fontColor=#326c8a;fontStyle=1;spacing=0;" vertex="1" id="element-661" parent="1">
          <mxGeometry x="1390" y="1183" width="285.0" height="22.950000000000003" as="geometry" />
        </mxCell>
        <mxCell style="fontFamily=Segoe UI;edgeStyle=none;endArrow=none;strokeColor=#bdc6cd;strokeWidth=1;" id="element-662" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="1285" as="sourcePoint" />
            <mxPoint x="1740" y="1285" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell value="Синий → основной путь; синий пунктир → обход. Охра → возврат после открытия D1. Зелёный → видимость из P0–P3." style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-663" parent="1">
          <mxGeometry x="60" y="1302" width="989.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="Серые блоки — крупные препятствия. I / II / III? — роли угроз, количество условно. W? / +Ф / +О — предложения выдачи и награды." style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-664" parent="1">
          <mxGeometry x="60" y="1332" width="1114.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="Весь уровень тёмный. Повороты не сбрасывают агрессию. Размеры, свет, бой и длительность 30 / 50 минут требуют будущей игровой проверки." style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-665" parent="1">
