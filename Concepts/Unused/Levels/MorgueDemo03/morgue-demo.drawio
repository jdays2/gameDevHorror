        <mxCell value="1 · Знание до выбора" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=21;fontColor=#30373e;fontStyle=1;spacing=0;" vertex="1" id="element-631" parent="1">
