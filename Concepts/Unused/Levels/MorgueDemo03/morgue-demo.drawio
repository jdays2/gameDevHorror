          <mxGeometry x="1390" y="277" width="79.0" height="24.3" as="geometry" />
        </mxCell>
        <mxCell value="2 · Цена A / B" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=21;fontColor=#30373e;fontStyle=1;spacing=0;" vertex="1" id="element-636" parent="1">
          <mxGeometry x="1390" y="326" width="145.0" height="28.35" as="geometry" />
        </mxCell>
        <mxCell value="A — короткий путь с новым риском" style="fontFamily=Segoe UI;text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#30373e;fontStyle=0;spacing=0;" vertex="1" id="element-637" parent="1">
